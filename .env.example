# ==============================================================================
# AeroSphere 360 - Environment Variables Template
# Copy this file to .env and adjust the values to your setup.
# ==============================================================================

# Branding & attribution
VITE_SITE_TITLE="AeroSphere 360"
VITE_SITE_TAGLINE="Ultra-HD 360° Spherical Panoramas"
VITE_SHOW_CREDIT="true"

# Storage Mode:
# - 'local' (default): Direct streaming from local bundled assets in frontend/public.
#   Allows out-of-the-box exploration without any external cloud / CDN setup.
# - 'remote': Streams high-resolution panoramas and thumbnails from external cloud storage / CDN / Cloudflare R2.
VITE_STORAGE_MODE="local"

# Local Storage Endpoints (used when VITE_STORAGE_MODE=local or as fallback)
VITE_THUMBNAILS_URL="/thumbnails"
VITE_PANORAMAS_2K_URL="/panoramas_2k"
VITE_PANORAMAS_WEB_URL="/panoramas_web"

# Remote Storage Endpoints (used when VITE_STORAGE_MODE=remote)
# Point these to your public Cloudflare R2 bucket / AWS S3 / CDN endpoint:
VITE_REMOTE_THUMBNAILS_URL="https://your-storage.example.com/thumbnails"
VITE_REMOTE_2K_URL="https://your-storage.example.com/panoramas_2k"
VITE_REMOTE_WEB_URL="https://your-storage.example.com/panoramas_web"

# Development tunnel (optional, for local development against live proxy)
VITE_TUNNEL_URL=""

# Admin Authentication (Optional - Google OAuth)
VITE_ADMIN_EMAIL=""
VITE_GOOGLE_CLIENT_ID=""

# Analytics (Optional)
VITE_GA_MEASUREMENT_ID=""
